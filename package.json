{
  "name": "posterly",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted multi-platform video poster. Send a video to one HTTP endpoint, it publishes to YouTube, TikTok, Instagram, Facebook, X and LinkedIn.",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "worker": "POSTER_MODE=worker node src/index.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "lint": "node --check src/index.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "multer": "^2.4.0",
    "zod": "^3.24.1"
  },
  "optionalDependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "better-sqlite3": "^11.7.0"
  },
  "keywords": [
    "video",
    "upload",
    "social-media",
    "youtube",
    "tiktok",
    "instagram",
    "facebook",
    "x",
    "linkedin",
    "api",
    "automation"
  ],
  "license": "MIT"
}
