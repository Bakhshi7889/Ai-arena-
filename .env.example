# ---------------------------------------------------------------------------
# Posterly configuration. Copy to `.env` and edit.
# ---------------------------------------------------------------------------

# --- Server -----------------------------------------------------------------
PORT=4000
HOST=0.0.0.0
# Public origin of THIS service. Platform APIs that pull the video by URL
# (TikTok PULL_FROM_URL, Instagram Reels, Facebook file_url) must be able to
# reach it. Must NOT be localhost when publishing for real.
PUBLIC_BASE_URL=http://localhost:4000

# --- Security ---------------------------------------------------------------
# Used to encrypt stored OAuth tokens and sign media URLs / webhooks.
# REQUIRED in production. Generate with: openssl rand -hex 32
POSTER_SECRET=change-me-please-32-bytes-minimum-long

# Dashboard login
POSTER_ADMIN_USER=admin
POSTER_ADMIN_PASSWORD=posterly

# Comma separated list of websites allowed to call the API from the browser
# (the embeddable widget). Use * only for local testing.
ALLOWED_ORIGINS=*

# --- Storage ----------------------------------------------------------------
DATA_DIR=./data
MAX_UPLOAD_MB=512
# Optional S3-compatible storage. Leave blank to store videos on local disk.
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Queue ------------------------------------------------------------------
QUEUE_CONCURRENCY=2
QUEUE_POLL_MS=750
MAX_ATTEMPTS=5

# --- Media ------------------------------------------------------------------
# ffmpeg is optional. When missing, Posterly validates and forwards the source
# file as-is instead of transcoding per-platform variants.
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe

# --- Run mode ---------------------------------------------------------------
# "all" = HTTP API + queue worker in one process (simplest)
# "server" = HTTP API only, "worker" = queue worker only
POSTER_MODE=all
# auto = use a simulated platform transport for connections that have no real
# credentials, so you can exercise the whole pipeline before applying for API
# access. "always" = never call real platform APIs. "never" = fail instead.
POSTER_SANDBOX=auto

# --- Platform OAuth apps (one block per network you want to publish to) -----
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
